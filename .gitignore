/vendor/
/composer.phar
/composer-setup.php
/.env
/.env.*
!/.env.example

# Runtime state and secrets that must never leave the server.
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/private/*
/storage/backups/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/sessions/.gitkeep
!/storage/private/.gitkeep
!/storage/backups/.gitkeep
/public/assets/uploads/*
!/public/assets/uploads/.gitkeep
/public/sitemap.xml
/public/build/

# Local tooling artifacts
/phpunit.xml.bak
/.phpunit.result.cache
/coverage/
.phpcs-report.xml

# Editors / OS
/.idea/
/.vscode/
*.swp
Thumbs.db
.DS_Store
