{
    "name": "dexxoxx/digital-subscription-marketplace",
    "description": "DexxoxxBD - a production-oriented digital subscription marketplace built on native PHP 8 MVC with MySQL.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true
    },
    "scripts": {
        "migrate": "phinx migrate",
        "seed": "phinx seed:run",
        "status": "phinx status",
        "rollback": "phinx rollback",
        "test": "phpunit",
        "lint": "phpcs"
    }
}
