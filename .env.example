# ---------------------------------------------------------------------------
# DexxoxxBD environment template.
#   copy this file to .env, then fill the blanks before running the installer
#   php scripts/maintenance/provision_database.php   creates the MySQL schema + app user
#   vendor/bin/phinx migrate -e development
#   vendor/bin/phinx seed:run -e development
# Never commit .env. Nothing secret is stored in the database.
# ---------------------------------------------------------------------------

APP_NAME="DexxoxxBD"
APP_ENV=local
APP_DEBUG=true
# The web server only exposes public/. Keep the path suffix when serving from a
# XAMPP htdocs sub-folder, e.g. http://localhost/DexxoxxBD/public
APP_URL=http://localhost/DexxoxxBD/public
# 32-byte application secret (session/HMAC pepper). Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# --- Database (MySQL only; there is no other driver in this project) --------
# XAMPP often runs MySQL/MariaDB on 3307 when another instance holds 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dexxoxxbd_marketplace
DB_USERNAME=dexxoxx_app
DB_PASSWORD=

# Dedicated schema for PHPUnit - never point this at development or live data.
DB_TEST_DATABASE=dexxoxxbd_marketplace_test

# --- Locale, money, time ----------------------------------------------------
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
# en or bn
DEFAULT_LOCALE=en

# --- Mail -------------------------------------------------------------------
# log writes messages to storage/logs so a local install can "send" without SMTP.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dexxoxxbd.test
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO=support@dexxoxxbd.test

# --- Payment gateways -------------------------------------------------------
# mock is a working sandbox gateway for demos and tests; it is disabled by
# APP_ENV=production. Never enable real gateways without checking the webhook
# token below - callbacks are verified server side and a browser redirect is
# never treated as payment proof.
PAYMENT_DEFAULT_GATEWAY=mock
PAYMENT_MOCK_ENABLED=true
PAYMENT_BANK_ENABLED=true
PAYMENT_MANUAL_ENABLED=true
PAYMENT_SSLCOMMERZ_ENABLED=false
PAYMENT_BKASH_ENABLED=false
PAYMENT_NAGAD_ENABLED=false
MOCK_GATEWAY_LATENCY_MS=400
REFUND_WINDOW_DAYS=7
# Shared secret that must be presented to the gateway notification endpoints.
# Generate with: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
PAYMENT_WEBHOOK_TOKEN=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.nagad.com:20006/api/dp/dpscp-merchant-payment

# Bank-transfer instructions shown at checkout for manual verification.
BANK_NAME=City Bank
BANK_BRANCH=Gulshan, Dhaka
BANK_ACCOUNT_NAME=DexxoxxBD Digital Services
BANK_ACCOUNT_NUMBER=
BANK_ROUTING=

# --- Credential encryption --------------------------------------------------
# Base64-encoded 32-byte AES-256-GCM key for digital inventory (licence keys and
# codes). The key material normally lives in storage/private/encryption.key, which
# is git-ignored and outside the web root; this value is only the fallback for a
# host that cannot keep a file. Either way the key never enters MySQL.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
INVENTORY_ENCRYPTION_KEY=

# --- Sessions, cache, logging ----------------------------------------------
SESSION_LIFETIME=120
CACHE_DRIVER=file
LOG_RETENTION_DAYS=90

# --- Transport security ---------------------------------------------------
# Turn these on only once the site really is served over TLS.
FORCE_HTTPS=false
FORCE_SECURE_COOKIES=false
HSTS_ENABLED=false
# Set true only behind a load balancer that sets X-Forwarded-* trustworthily.
TRUST_PROXY_HEADERS=false

# --- Seeded accounts -------------------------------------------------------
# AdminUserSeeder creates this account. Leave ADMIN_PASSWORD empty and the
# seeder generates one, prints it once, and forces a change on first login.
ADMIN_NAME="Site Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password applied to the four demo customer accounts created by
# DemoUserSeeder. Documented in README.md; delete those accounts before launch.
DEMO_USER_PASSWORD=
