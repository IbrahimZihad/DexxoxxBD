APP_NAME="ZapSub"
APP_ENV=local
APP_DEBUG=true
# Leave blank to let the app derive its own base URL from the request. Set it
# only when you put the site behind a real domain or a reverse proxy.
APP_URL=
APP_TIMEZONE=Asia/Dhaka
# Generate with `composer key` (64 hex chars). Required: it is the AES-256-GCM
# key used to encrypt the account details that admin attaches to a delivered
# order. Without it, delivery notes are stored unencrypted and the app warns.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=zapsub
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=zapsub_session
SESSION_LIFETIME=7200

# Sliding-window limits, applied per IP. Format: attempts,window_seconds.
RATE_LOGIN=5,900
RATE_REGISTER=3,3600
RATE_CHECKOUT=15,3600
RATE_GUEST_ORDER=8,3600
RATE_CONTACT=6,3600
RATE_TRACK=20,600
RATE_RESET=4,3600
RATE_GENERAL=120,60
RATE_CART=40,60
RATE_COUPON=10,60

# Optional card checkout. With these empty the "Card" rail is not offered at all.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Logins created by UserSeeder (admin@zapsub.test / rafi@zapsub.test /
# tanvir@example.com). `composer seed` refuses to run when these are blank, so a
# password is never invented by the code or committed to the repository.
# Minimum 8 characters. Change the admin password from the panel before launch.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Email: "log" writes the message body to storage/logs/mail.log, "mail" uses
# PHP's mail() transport.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="ZapSub Support"
