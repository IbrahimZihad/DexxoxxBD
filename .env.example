# DexxoxxBD environment — copy to .env and fill in real values.
# Never commit .env. Nothing below is a working credential.
# Keys are case-insensitive; process environment variables override this file.

APP_ENV=production
APP_DEBUG=false
APP_NAME=DexxoxxBD
APP_TIMEZONE=Asia/Dhaka

# Absolute base URLs. SITE_URL is where the HTML pages are served from;
# API_BASE_URL and FRONTEND_URL default to SITE_URL and SITE_URL/api.
# On XAMPP with the project inside htdocs the pages live under /public.
SITE_URL=http://localhost/DexxoxxBD/public
API_BASE_URL=http://localhost/DexxoxxBD/public/api
FRONTEND_URL=http://localhost/DexxoxxBD/public

# Only needed when the frontend is hosted apart from the API.
ALLOWED_ORIGINS=

# --- Database (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dexxoxxbd
DB_USER=dexxoxxbd
DB_PASS=change-me

# --- Sessions ---
SESSION_NAME=dexxoxx_session
SESSION_LIFETIME=28800
SESSION_IDLE_TIMEOUT=7200

# --- Security ---
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
# Comma-separated reverse-proxy IPs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=

# --- Rate limits (hits allowed per window) ---
THROTTLE_READ_HITS=240
THROTTLE_LOGIN_ATTEMPTS=8
THROTTLE_REGISTER_ATTEMPTS=5
THROTTLE_ORDER_CREATES=30
THROTTLE_PAYMENT_INITIATIONS=20
THROTTLE_MANUAL_PAYMENT_SUBMITS=20

# --- Orders ---
PENDING_ORDER_TTL_MINUTES=360

# --- SSLCommerz (leave blank to disable card checkout; manual payments still work) ---
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_SANDBOX=true
SSLCZ_CURRENCY=BDT

# --- Manual payments (bKash / Nagad / Rocket / bank) ---
# Numbers live in the `settings` table and are edited from the admin UI.
MANUAL_PAYMENTS_ENABLED=true
