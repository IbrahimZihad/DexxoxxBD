APP_NAME="Digital Subscription Marketplace"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/digital-subscription-marketplace/public
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_subscription_marketplace
DB_USERNAME=root
DB_PASSWORD=

# Separate schema used by `vendor/bin/phpunit`; never point this at production data.
DB_TEST_DATABASE=digital_subscription_marketplace_test

DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCALE=en

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Base64-encoded 32-byte AES-256 key for digital inventory encryption. Kept out of MySQL.
INVENTORY_ENCRYPTION_KEY=

CACHE_DRIVER=file
SESSION_LIFETIME=120

ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
