<?xml version="1.0"?>
<!--
    PHP_CodeSniffer ruleset for DexxoxxBD (`composer lint`).

    PSR-12 is the baseline. The deviations below are deliberate and each one is
    a consequence of how Phinx, the schema generator and the CLI scripts work;
    they are not licences to write loosely.
-->
<ruleset name="DexxoxxBD">
    <description>PSR-12 with the documented Phinx and generator exceptions.</description>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="4"/>
    <arg name="cache" value=".phpcs-cache"/>

    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>public</file>
    <file>resources</file>
    <file>routes</file>
    <file>scripts</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>public/assets/*</exclude-pattern>
    <exclude-pattern>public/uploads/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Phinx loads a seeder or a migration by requiring the file and
         instantiating the class named after it, so both stay in the global
         namespace. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>database/seeders/*</exclude-pattern>
        <exclude-pattern>database/migrations/*</exclude-pattern>
    </rule>

    <!-- Migrations, config, routes and CLI scripts are declarations plus the
         side effects they exist to perform. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>scripts/*</exclude-pattern>
        <exclude-pattern>config/*</exclude-pattern>
        <exclude-pattern>routes/*</exclude-pattern>
        <exclude-pattern>bootstrap/*</exclude-pattern>
        <exclude-pattern>database/*</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>

    <!-- View templates are HTML with PHP interleaved, and the idiomatic control
         structures there are the alternative syntax (`<?php if ($x): ?>` …
         `<?php endif; ?>`). The Squiz control-signature sniff expects a brace
         followed by a newline, which that syntax cannot have, so it reports
         every template block as an error. The rest of PSR-12 still applies to
         templates. -->
    <rule ref="Squiz.ControlStructures.ControlSignature">
        <exclude-pattern>resources/views/*</exclude-pattern>
    </rule>

    <!-- Long SQL, CSP headers and translation strings read better on one line
         than split, so 120 columns is a warning and 160 an error. Demo content
         and the schema specs are data tables of prose, and migrations are
         generated from those specs - re-wrapping them by hand would be undone
         by the next generate_migrations run, so they are exempt. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>database/factories/*</exclude-pattern>
        <exclude-pattern>database/schema/*</exclude-pattern>
        <exclude-pattern>database/migrations/*</exclude-pattern>
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

</ruleset>
