# Deny by default. Only public/ is meant to be reachable over HTTP; this file is
# what stops a XAMPP-style "everything under htdocs is web root" setup from
# serving .env, app/, config/, storage/ or vendor/ to the internet.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(env|git|htaccess|htpasswd|phpunit)" - [F,L,NC]
</IfModule>
