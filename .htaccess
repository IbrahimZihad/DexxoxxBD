# DexxoxxBD application root - deny-by-default guard.
#
# Only public/ is a web root; on a properly configured server this directory is
# not reachable at all, because the vhost's DocumentRoot points at public/.
# XAMPP-style setups serve the whole folder tree from htdocs/, so this file makes
# that mistake safe instead of fatal: everything under here is refused unless a
# deeper .htaccess grants access, and public/.htaccess is the one that grants it.
#
# Nothing here is a substitute for the vhost. README documents the correct setup.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Belt and braces for servers where the grant below is inherited loosely.
    RewriteRule "(^|/)\.(env|git|htaccess|htpasswd)" - [F,L,NC]
</IfModule>
